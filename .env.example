# Copy to .env and adjust. Never commit the real .env file.

# Server
PORT=4000
NODE_ENV=production
# Where the SQLite database, uploads and dev mail outbox are stored. Back this folder up.
ATLAS_DATA_DIR=./data
# Public URL users reach the portal on (used in password reset / invitation links)
ATLAS_APP_URL=https://atlas.example.com
# Secure cookies require HTTPS. Only set to false for local HTTP development.
ATLAS_SECURE_COOKIES=true
# Set to true when running behind a reverse proxy / load balancer that sets X-Forwarded-For
ATLAS_TRUST_PROXY=true

# Sessions
ATLAS_SESSION_TTL_HOURS=12
ATLAS_REMEMBER_DAYS=30

# Login protection
ATLAS_MAX_FAILED_LOGINS=5
ATLAS_LOCKOUT_MINUTES=15
ATLAS_RESET_TOKEN_MINUTES=60
ATLAS_INVITE_TOKEN_HOURS=72

# Uploads
ATLAS_MAX_IMAGE_MB=8
ATLAS_MAX_DOCUMENT_MB=20

# Dashboard links
# Allow http:// dashboard links (e.g. plant intranet). Strongly discouraged; HTTPS is the default requirement.
ATLAS_ALLOW_HTTP_DASHBOARDS=false
# "Verify link" makes a credential-free request to the dashboard host. Disable if outbound traffic is not allowed.
ATLAS_DASHBOARD_CHECKS=true
ATLAS_DASHBOARD_CHECK_TIMEOUT_MS=8000
# Permit checks against private/internal IP ranges (SSRF protection is on by default)
ATLAS_ALLOW_PRIVATE_CHECKS=false

# One-off admin creation (optional; otherwise `npm run create-admin` prompts).
# ATLAS_ADMIN_EMAIL accepts an email address or a user ID such as atlas@admin.
# The password must be changed at first sign-in; remove it from the environment afterwards.
# On Vercel these are read by api/index.js to provision the Super Admin if it does not exist.
# ATLAS_ADMIN_EMAIL=
# ATLAS_ADMIN_NAME=
# ATLAS_ADMIN_PASSWORD=
